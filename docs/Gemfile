source "https://rubygems.org"

# -----------------------------------------------------
# ✅ Use GitHub Pages-managed Jekyll and plugins
# -----------------------------------------------------
gem "github-pages", "~> 232", group: :jekyll_plugins

# -----------------------------------------------------
# ✅ Optional: Aviator-related plugins (all are safe)
# -----------------------------------------------------
gem "jekyll-paginate"
gem "jekyll-sitemap"

# -----------------------------------------------------
# ✅ Windows and JRuby platform fixes
# -----------------------------------------------------
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

# Performance booster for Windows file watching
gem "wdm", "~> 0.1", platforms: [:mingw, :x64_mingw, :mswin]

# Lock `http_parser.rb` for JRuby builds
gem "http_parser.rb", "~> 0.6.0", platforms: [:jruby]